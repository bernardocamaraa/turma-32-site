# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings → API in the Supabase dashboard). These two are safe to
# expose in the browser bundle — they're the public anon key, not a secret.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: the committee access code is NOT set here. It's a secret used by the
# `committee-data` Edge Function (supabase/functions/committee-data), set with:
#   supabase secrets set COMMITTEE_CODE=turma32
# See README.md for the full setup.
